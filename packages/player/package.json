{
  "name": "@abolkit/player",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "<abol-player>: embeddable accessible video player (custom element, Shadow DOM, IIFE + ESM builds).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CuriousDev101/abolkit.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/CuriousDev101/abolkit/tree/main/packages/player#readme",
  "sideEffects": [
    "./dist/abol-player.js",
    "./dist/abol-player.esm.js",
    "./dist/abol-player.lite.js",
    "./dist/abol-player.stream.js",
    "./dist/abol-player.braille.js",
    "./dist/abol-player.braille.capi.js"
  ],
  "main": "./dist/abol-player.esm.js",
  "module": "./dist/abol-player.esm.js",
  "types": "./dist/abol-player.d.ts",
  "browser": "./dist/abol-player.js",
  "unpkg": "./dist/abol-player.js",
  "jsdelivr": "./dist/abol-player.js",
  "exports": {
    ".": {
      "types": "./dist/abol-player.d.ts",
      "import": "./dist/abol-player.esm.js",
      "default": "./dist/abol-player.esm.js"
    },
    "./lite": "./dist/abol-player.lite.js",
    "./stream": "./dist/abol-player.stream.js",
    "./braille": "./dist/abol-player.braille.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@abolkit/core": "workspace:*",
    "@videojs/html": "^10.4.0",
    "@videojs/youtube-video": "10.4.0",
    "esbuild": "^0.28.2",
    "liblouis": "0.4.0",
    "liblouis-build": "3.2.0-rc",
    "vitest": "^5.1.0"
  }
}
