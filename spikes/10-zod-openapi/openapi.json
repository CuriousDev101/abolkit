{
  "openapi": "3.1.0",
  "info": {
    "title": "Abol Kit API",
    "version": "0.0.0",
    "description": "HTTP API skeleton for Abol Kit (#17). This process does not run speech-to-text. The worker calls a separate MMS ASR service (TRANSCRIBER_URL). Read routes are open with CORS; write routes (#24+) will require API_KEY. No path in this document accepts audio or returns a transcript."
  },
  "servers": [
    {
      "url": "/",
      "description": "This API origin. A host page on another origin calls it with CORS."
    }
  ],
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION"
              },
              "message": {
                "type": "string",
                "example": "Invalid request"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [true],
            "example": true
          },
          "service": {
            "type": "string",
            "enum": ["abolkit-api"],
            "example": "abolkit-api"
          }
        },
        "required": ["ok", "service"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["System"],
        "summary": "Liveness",
        "description": "Reports that this API process is up. It does not call the speech-to-text service. That service is a separate MMS ASR wrapper reached only by the worker.",
        "responses": {
          "200": {
            "description": "This API process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
