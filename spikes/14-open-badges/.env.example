# Private issuer key as a compact JSON JWK string (Ed25519 OKP).
# Prefer loading from a file mount in production; never commit the private key.
# Generate locally: pnpm keys
CREDENTIALS_ISSUER_PRIVATE_JWK=

# Optional path override (default: keys/private.jwk next to this package)
# CREDENTIALS_ISSUER_PRIVATE_JWK_PATH=keys/private.jwk
