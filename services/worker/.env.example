# Default STT after spike #7: external MMS ASR wrapper (no model in abolkit).
TRANSCRIBER=mms-http
TRANSCRIBER_URL=http://mms-stt:8000

# Local work without the Python service:
# TRANSCRIBER=stub

TRANSLATOR=none
TTS=recorded-clips

# Storage must match the API (ADR 0005). Prefer STORAGE_PROVIDER; STORAGE is accepted too.
STORAGE_PROVIDER=local-disk
STORAGE_LOCAL_ROOT=../api/data/storage
STORAGE_SIGNING_SECRET=dev-signing-secret-change-me
# PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional: absolute path when ffmpeg is not on PATH (Docker image already has it).
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# Temp parent for extract/rendition work folders.
# WORKER_WORK_DIR=/tmp/abolkit-worker

# DB-backed job queue (ADR 0005). Must be the same SQLite file as the API.
# No Docker (run from services/worker): file:../api/data/abolkit.sqlite
# In containers: file:/data/abolkit.sqlite
DATABASE_URL=file:../api/data/abolkit.sqlite
JOB_POLL_INTERVAL_MS=1500
JOB_LEASE_SECONDS=120
# Retry backoff: base * 2^(attempt-1), capped. JOB_MAX_ATTEMPTS is read by the API when it queues a job.
JOB_RETRY_BASE_MS=2000
JOB_RETRY_MAX_MS=60000
