# Default STT after spike #7: external MMS ASR wrapper (no model in abolkit).
TRANSCRIBER=mms-http
TRANSCRIBER_URL=http://mms-stt:8000

# Local work without the Python service:
# TRANSCRIBER=stub

TRANSLATOR=none
TTS=recorded-clips
STORAGE=local-disk

