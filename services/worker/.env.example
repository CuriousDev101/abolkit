# Compose (#43) defaults to stub so no external MMS container is required.
TRANSCRIBER=stub

# External MMS ASR wrapper (spike #7; model not in abolkit):
# TRANSCRIBER=mms-http
# TRANSCRIBER_URL=http://mms-stt:8000

# Optional cloud adapter (off by default). Requires explicit operator consent (ADR 0003):
# TRANSCRIBER=cloud
# TRANSCRIBER_OFF_HOST_CONSENT=true

TRANSLATOR=none
TTS=recorded-clips

# URL captions (ADR 0007): set both to run the BullMQ transcribe/translate workers.
# AssemblyAI / Gemini settings and the CAPTION_* options are listed in the root .env.example.
# POSTGRES_URL=postgres://abolkit:change-me-please@localhost:5432/abolkit
# REDIS_URL=redis://localhost:6379
# TRANSCRIBER=assemblyai
# TRANSCRIBER_OFF_HOST_CONSENT=true
# ASSEMBLYAI_API_KEY=
# TRANSLATOR=gemini
# TRANSLATOR_OFF_HOST_CONSENT=true
# GEMINI_API_KEY=

# Storage must match the API (ADR 0005). Prefer STORAGE_PROVIDER; STORAGE is accepted too.
STORAGE_PROVIDER=local-disk
STORAGE_LOCAL_ROOT=../api/data/storage
STORAGE_SIGNING_SECRET=dev-signing-secret-change-me
# PUBLIC_BASE_URL=http://127.0.0.1:8787

# Optional: absolute path when ffmpeg is not on PATH (Docker image already has it).
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# Temp parent for extract/rendition work folders.
# WORKER_WORK_DIR=/tmp/abolkit-worker

# Required before translator/TTS cloud adapters (ALLOW_OFF_HOST_PROVIDERS).
# Transcriber cloud consent is TRANSCRIBER_OFF_HOST_CONSENT above.
# ALLOW_OFF_HOST_PROVIDERS=true

# DB-backed job queue (ADR 0005). Must be the same SQLite file as the API.
# Optional when POSTGRES_URL + REDIS_URL are set (the worker then runs only the caption queues).
# No Docker (run from services/worker): file:../api/data/abolkit.sqlite
# In containers: file:/data/abolkit.sqlite
DATABASE_URL=file:../api/data/abolkit.sqlite
JOB_POLL_INTERVAL_MS=1500
JOB_LEASE_SECONDS=120
# Retry backoff: base * 2^(attempt-1), capped. JOB_MAX_ATTEMPTS is read by the API when it queues a job.
JOB_RETRY_BASE_MS=2000
JOB_RETRY_MAX_MS=60000
