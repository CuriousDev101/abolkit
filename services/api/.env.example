# This process is the HTTP API only (#17).
# Speech-to-text is a separate service. Configure it on the worker:
#   services/worker/.env.example  (TRANSCRIBER, TRANSCRIBER_URL)

PORT=8787

# Read routes (health, OpenAPI, docs, widget script).
# * lets a page on another origin call the API after a script-tag embed.
CORS_ORIGIN=*

# Required for write routes (#24+). Leave empty while only reads are mounted.
# API_KEY=change-me
