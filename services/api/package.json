{
  "name": "@abolkit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "description": "Hono + zod-openapi REST API: assets, jobs, lessons/cues, offline packs, credentials. Serves the OpenAPI spec and docs.",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "openapi:write": "node --experimental-strip-types scripts/write-openapi.ts",
    "client:generate": "node --experimental-strip-types scripts/write-openapi.ts && openapi-typescript ../../spikes/10-zod-openapi/openapi.json -o scripts/schema.d.ts",
    "client:check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.client.json",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "smoke:assets": "node --experimental-strip-types scripts/smoke-assets.ts",
    "spike:smoke": "pnpm smoke"
  },
  "dependencies": {
    "@abolkit/core": "workspace:*",
    "@abolkit/jobs": "workspace:*",
    "@abolkit/provider-sdk": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/api-reference": "^1.78.1",
    "@scalar/hono-api-reference": "^0.12.20",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.0"
  }
}
