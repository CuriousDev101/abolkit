{
  "name": "abolkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Abol Kit: accessible learning-media toolkit (embeddable video player, captions pipeline, job card).",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "dev:api": "pnpm --filter @abolkit/api dev",
    "smoke:api": "pnpm --filter @abolkit/api smoke",
    "smoke:assets": "pnpm --filter @abolkit/api smoke:assets",
    "gh:labels": "bash scripts/gh-labels.sh",
    "gh:issues": "bash scripts/gh-issues.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
