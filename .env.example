# Copy to .env and fill secrets + provider keys. Never commit .env.
# See docs-internal/decisions/0007-url-captions-postgres-redis.md
# Required by: docker compose up  (local) and docker compose -f docker-compose.prod.yml up (EC2)

# --- API ---
# Inside containers Compose sets HOST=0.0.0.0; this HOST is for local `pnpm dev:api`.
HOST=127.0.0.1
PORT=8787
API_KEY=dev-api-key-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8787
CORS_ORIGIN=*

# --- MinIO (Compose) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=abolkit
# At least 8 characters; also the MinIO root password.
MINIO_SECRET_KEY=change-me-please
MINIO_BUCKET=abolkit-media
MINIO_USE_SSL=false
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# --- Postgres (Compose builds POSTGRES_URL from these) ---
POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=abolkit

# --- Captions (ADR 0007) ---
# CAPTION_ALLOWED_HOSTS=* allows YouTube + direct media URLs (demo default).
CAPTION_ALLOWED_HOSTS=*
TRANSLATION_LANGUAGES=am,om,ti,aa
CAPTION_DEFAULT_SOURCE_LANGUAGE=en
CAPTION_MAX_DURATION_SECONDS=3600
CAPTION_CACHE_TTL_SECONDS=86400
CAPTION_JOB_ATTEMPTS=3
CAPTION_JOB_BACKOFF_MS=10000

CAPTION_TRANSCRIBE_CONCURRENCY=1
CAPTION_TRANSLATE_CONCURRENCY=2
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JOB_REQUESTS=10
RATE_LIMIT_READ_REQUESTS=300
TRUST_PROXY=false

# --- Speech to text (worker) ---
TRANSCRIBER=assemblyai
TRANSCRIBER_OFF_HOST_CONSENT=true
ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# --- Translation (worker) ---
TRANSLATOR=gemini
TRANSLATOR_OFF_HOST_CONSENT=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Optional ---
# STORAGE_PROVIDER=local-disk
# STORAGE_LOCAL_ROOT=./data/storage
# STORAGE_SIGNING_SECRET=dev-signing-secret-change-me
# DATABASE_URL=file:./data/abolkit.sqlite
# YTDLP_COOKIES_FILE=/data/youtube-cookies.txt
# TRANSCRIBER=mms-http
# TRANSCRIBER_URL=http://mms-stt:8000
# TRANSLATOR=stub
# TTS=assemblyai
# TTS_OFF_HOST_CONSENT=true
