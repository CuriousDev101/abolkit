# Copy to .env and adjust. Never commit real secrets.
# See docs-internal/decisions/0007-url-captions-postgres-redis.md
# docker-compose.yml reads this file; it already points the services at each other
# (POSTGRES_URL, REDIS_URL, MINIO_ENDPOINT), so only set those here when running without Compose.

# --- API listen (#43) ---
# Local `pnpm dev:api`: 127.0.0.1 is fine.
# Docker Compose always forces HOST=0.0.0.0 inside containers (see compose.yaml).
HOST=127.0.0.1
PORT=8787
# Required for write routes (upload, enqueue jobs). Change for anything shared.
API_KEY=dev-api-key-change-me
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=*

# --- Storage (Compose default: MinIO is mandatory) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=abolkit
# At least 8 characters; also the MinIO root password in Compose.
MINIO_SECRET_KEY=change-me-please
MINIO_BUCKET=abolkit-media
MINIO_USE_SSL=false
# Community MinIO build used by Compose (official images are no longer published).
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z

# --- Storage (tests / no-Docker) ---
# STORAGE_PROVIDER=local-disk
# STORAGE_LOCAL_ROOT=./data/storage
# STORAGE_SIGNING_SECRET=dev-signing-secret-change-me

# --- Legacy asset uploads (optional; not used by Compose URL captions) ---
# DATABASE_URL=file:./data/abolkit.sqlite
# JOB_POLL_INTERVAL_MS=1500
# JOB_LEASE_SECONDS=120
# JOB_MAX_ATTEMPTS=3
# API_KEY=change-me
# ASSET_MAX_BYTES=104857600
# ASSET_RETENTION_DAYS=7
# SIGNED_URL_TTL_SECONDS=3600

# --- API process ---
# HOST=127.0.0.1                      # 0.0.0.0 in a container (Compose sets it)
# PORT=8787
# PUBLIC_BASE_URL=http://localhost:8787   # origin used in caption file URLs
# CORS_ORIGIN=*

# --- URL captions (ADR 0007): Postgres + Redis (BullMQ, cache, rate limit) + MinIO ---
# Without both URLs the caption endpoints answer 503 and the worker skips the caption queues.
POSTGRES_USER=abolkit
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=abolkit
# POSTGRES_URL=postgres://abolkit:change-me-please@localhost:5432/abolkit
# REDIS_URL=redis://localhost:6379
# CAPTION_REDIS_PREFIX=abol
# Hosts the worker may download from (subdomains included). `*` allows YouTube and direct media URLs.
CAPTION_ALLOWED_HOSTS=*
# Translation targets: Amharic, Afaan Oromo, Tigrinya, Afar. Source VTT is the transcript.
TRANSLATION_LANGUAGES=am,om,ti,aa
# Spoken language when the request omits sourceLanguage (always English unless overridden).
CAPTION_DEFAULT_SOURCE_LANGUAGE=en
# Longer videos are refused before download (seconds).
CAPTION_MAX_DURATION_SECONDS=3600
CAPTION_CACHE_TTL_SECONDS=86400
CAPTION_JOB_ATTEMPTS=3
CAPTION_JOB_BACKOFF_MS=10000
CAPTION_TRANSCRIBE_CONCURRENCY=2
CAPTION_TRANSLATE_CONCURRENCY=4
# Per client IP, per window. Set TRUST_PROXY=true only behind a reverse proxy you control.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_JOB_REQUESTS=10
RATE_LIMIT_READ_REQUESTS=300
TRUST_PROXY=false

# --- Audio extraction (worker) ---
# YTDLP_BIN=yt-dlp
# YTDLP_JS_RUNTIMES=node
# Netscape cookies file, if YouTube asks the server to sign in:
# YTDLP_COOKIES_FILE=/data/youtube-cookies.txt
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# FFPROBE_BIN=/usr/local/bin/ffprobe

# --- Speech to text (worker) ---
# AssemblyAI receives the lesson audio (off-host). Consent defaults on for URL captions.
TRANSCRIBER=assemblyai
TRANSCRIBER_OFF_HOST_CONSENT=true
ASSEMBLYAI_API_KEY=
# EU data residency: https://api.eu.assemblyai.com
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# Models tried in order (comma separated).
# ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2
# Optional fixed language for every job (otherwise the request / CAPTION_DEFAULT_SOURCE_LANGUAGE wins):
# ASSEMBLYAI_LANGUAGE_CODE=
# ASSEMBLYAI_LANGUAGE_DETECTION=false
# ASSEMBLYAI_PUNCTUATE=true
# ASSEMBLYAI_FORMAT_TEXT=true
# ASSEMBLYAI_SPEAKER_LABELS=false
# ASSEMBLYAI_ENTITY_DETECTION=false
# ASSEMBLYAI_KEYTERMS=fraction,denominator
# ASSEMBLYAI_EXTRA_PARAMS={"multichannel":false}
# ASSEMBLYAI_CHARS_PER_CAPTION=42
# ASSEMBLYAI_POLL_INTERVAL_MS=3000
# ASSEMBLYAI_TIMEOUT_MS=1800000
# Self-hosted alternative:
# TRANSCRIBER=mms-http
# TRANSCRIBER_URL=http://mms-stt:8000

# --- Translation (worker) ---
# Gemini receives caption text only (never timestamps). Consent defaults on.
# TRANSLATOR=stub tags lines instead of translating (local testing); none turns translation off.
TRANSLATOR=gemini
TRANSLATOR_OFF_HOST_CONSENT=true
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_BATCH_SIZE=60
# GEMINI_TEMPERATURE=0.2

# --- Other providers ---
# TTS=recorded-clips
