# Copy to .env for local (non-Docker) runs. Compose injects its own defaults;
# you only need a .env if you want to override them.
# Never commit real secrets.
# See docs-internal/decisions/0005-storage-queue-db-defaults.md

# --- API listen (#43) ---
# Local `pnpm dev:api`: 127.0.0.1 is fine.
# Docker Compose always forces HOST=0.0.0.0 inside containers (see compose.yaml).
HOST=127.0.0.1
PORT=8787
# Required for write routes (upload, enqueue jobs). Change for anything shared.
API_KEY=dev-api-key-change-me
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGIN=*

# --- Storage (Compose default: MinIO is mandatory) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=abolkit
# Must be at least 8 characters for MinIO root password.
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=abolkit-media
MINIO_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Optional image override (Compose default: insectai/minio:latest).
# MINIO_IMAGE=minio/minio:latest

# --- Storage (tests / no-Docker) ---
# STORAGE_PROVIDER=local-disk
# STORAGE_LOCAL_ROOT=./data/storage
# STORAGE_SIGNING_SECRET=dev-signing-secret-change-me

# --- Database + DB-backed job queue (SQLite) ---
# Local pnpm (from repo root / services/api):
DATABASE_URL=file:./data/abolkit.sqlite
# Compose containers use: file:/data/abolkit.sqlite (set automatically in compose.yaml)
JOB_POLL_INTERVAL_MS=1500
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=2000
JOB_RETRY_MAX_MS=60000

# --- Asset upload (#24) ---
ASSET_MAX_BYTES=104857600
ASSET_RETENTION_DAYS=7
SIGNED_URL_TTL_SECONDS=3600

# --- Providers (ADR 0003 / issues #16, #27) ---
# Compose defaults to TRANSCRIBER=stub (no external MMS container required).
TRANSCRIBER=stub
# To use the external MMS wrapper instead:
# TRANSCRIBER=mms-http
# TRANSCRIBER_URL=http://mms-stt:8000
# TRANSCRIBER=cloud requires TRANSCRIBER_OFF_HOST_CONSENT=true
TRANSCRIBER_OFF_HOST_CONSENT=false
TRANSLATOR=none
TTS=recorded-clips
# Translator/TTS cloud adapters require ALLOW_OFF_HOST_PROVIDERS=true
ALLOW_OFF_HOST_PROVIDERS=false
